# Copy settings to the ignored .env file. Setup generates private service keys.
DATA_MODE=live
APP_ENV=development
API_IMAGE=data-horizon-api:local
COLLECTOR_IMAGE=data-horizon-collector:local
OPS_IMAGE=data-horizon-ops:local
DASHBOARD_IMAGE=data-horizon-ui:local
SPARK_IMAGE=data-horizon-spark:local
MAX_OFFSETS_PER_TRIGGER=20000
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
DASHBOARD_PUBLIC_URL=http://127.0.0.1:8501
KAFKA_UI_PORT=8082
KAFDROP_PORT=9000
# Optional source settings file inside the images. Rebuild after changing it.
# SOURCE_CONFIG=/app/configs/nyc.yaml
