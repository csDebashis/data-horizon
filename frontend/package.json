{
  "name": "data-horizon-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 18504",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 8501",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-reporter=junit --test-reporter-destination=reports/unit.xml test/*.test.mjs",
    "pretest": "node -e \"require('node:fs').mkdirSync('reports',{recursive:true})\""
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/server": "11.11.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@mui/material-nextjs": "9.5.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "typescript": "6.0.3"
  }
}
